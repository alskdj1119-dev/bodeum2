rules_version = '2';

// 보듬(bodeum-next) Firestore 보안 규칙.
//
// 로그인이 없다. 가족 코드를 아는 사람만 그 가족 문서에 들어온다.
// request.auth 로 막으면 앱이 바로 멈춘다.
//
// 데이터 노출
//   - families 목록 조회(list)는 막는다. 코드를 몰라도 모든 가족을 긁어갈 수 없다.
//   - 가족 코드를 아는 기기는 그 가족 문서(get)와 그 가족 기록만 본다.
//     다른 가족 코드의 기록은 경로가 달라 보이지 않는다.
//   - 건의사항(bodeum_requests)은 목록 화면이 있어서 앱을 여는 누구나 글과 답변을 볼 수 있다.
//     가족 코드나 아이 기록은 이 글에 넣지 않는다.
//
// 삭제
//   - 가족 문서 자체는 삭제할 수 없다. 설정과 요약이 한 번에 지워지지 않게 한다.
//   - 수유·기저귀 같은 기록 한 건은 삭제할 수 있다. 앱이 휴지통으로 옮길 때 원본을 지운다.
//   - 건의사항과 답변은 삭제할 수 없다. 상태 변경과 답글만 된다.
//
// TODO: Firebase 익명 인증 + families/{code}.members 로 읽기/쓰기를 좁힌다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isRecordCollection(name) {
      return name in [
        'feeds', 'diapers', 'sleeps', 'weights', 'temps', 'solids',
        'visits', 'symptoms', 'heights', 'headCircs', 'trash'
      ];
    }

    match /families/{code} {
      // 코드를 아는 경우만 문서 하나를 읽는다. 가족 목록은 막는다.
      allow get: if true;
      allow list: if false;
      // 설정·요약 수정은 된다. 가족 문서 삭제는 안 된다.
      allow create, update: if true;
      allow delete: if false;

      // 이 가족 코드 아래의 기록만 읽고, 한 건씩 수정·삭제한다.
      match /{collection}/{docId} {
        allow get, list: if isRecordCollection(collection);
        allow create, update: if isRecordCollection(collection);
        allow delete: if isRecordCollection(collection);
      }
    }

    match /bodeum_requests/{requestId} {
      // 목록이 열려 있어 글 내용은 노출된다. 가족 기록은 여기 없다.
      allow get, list, create, update: if true;
      allow delete: if false;

      match /comments/{commentId} {
        allow get, list, create, update: if true;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
