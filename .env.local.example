# 이 파일을 복사해서 .env.local로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local은 .gitignore에 포함돼 있어서 git에는 올라가지 않습니다 (로컬 전용).
#
# - 로컬에서 npm run dev로 개발할 때는 여기 있는 값을 씁니다.
# - Vercel에 배포할 때는 이 파일이 아니라 Vercel 프로젝트 설정의
#   Environment Variables(Production / Preview)에 같은 이름으로 값을 등록해야 합니다.
#
# 값은 Firebase 콘솔 > 프로젝트 설정 > 일반 탭의 "SDK 설정 및 구성"에서 확인할 수 있고,
# VAPID 키는 프로젝트 설정 > Cloud Messaging 탭 > 웹 구성 > 웹 푸시 인증서에서 확인합니다.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
